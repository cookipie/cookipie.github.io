{
  "$schema": "https://developers.cloudflare.com/workers/wrangler/config-schema.json",
  "name": "cookipie-github-io",
  "main": "./worker.js",
  "compatibility_date": "2026-10-18",
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cookipie-reviews",
      "database_id": "3dd00de4-7ca3-41f4-a678-3885e1420eab"
    }
  ],
  "r2_buckets": [
    {
      "binding": "RECIPE_IMAGES",
      "bucket_name": "cookipie-recipe-images"
    }
  ]
}
